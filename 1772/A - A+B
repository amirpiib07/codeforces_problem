#include <bits/stdc++.h>
using namespace std;
 
int main()
{
    int t;
    cin >> t;
 
    while (t--)
    {
        string s;
        cin >> s;
 
        int a = 0, b = 0;
        int i = 0;
 
        while (s[i] != '+')
        {
            a = a * 10 + (s[i] - '0');
            i++;
        }
 
        i++; // Skip '+'
 
        while (i < s.size())
        {
            b = b * 10 + (s[i] - '0');
            i++;
        }
 
        cout << a + b << '
';
    }
 
    return 0;
}