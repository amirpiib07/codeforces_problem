#include <bits/stdc++.h>
using namespace std;
int main() {
    int t;
    cin>>t;
    while(t--) {
        int rating;
        cin>>rating;
        if (1900 <= rating) {
            cout << "Division 1" << endl;
        }
        else if (rating >= 1600 && 1899 >= rating) {
            cout << "Division 2" << endl;
        }
        else if (rating >= 1400 && 1599 >= rating) {
            cout << "Division 3" << endl;
        }
        else {
            cout << "Division 4" << endl;
        }
    }
    return 0;
}